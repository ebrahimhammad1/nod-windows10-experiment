diff --git a/desktop/scripts/check-windows-engine-smoke.mjs b/desktop/scripts/check-windows-engine-smoke.mjs
new file mode 100644
index 0000000..7ecda56
--- /dev/null
+++ b/desktop/scripts/check-windows-engine-smoke.mjs
@@ -0,0 +1,72 @@
+// Runs only in a disposable Windows CI runner against the extracted shipped engine.
+import assert from 'node:assert/strict';
+import { mkdtemp, writeFile, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import { randomBytes } from 'node:crypto';
+
+assert.equal(process.platform, 'win32');
+assert.equal(process.arch, 'x64');
+assert.equal(process.env.GITHUB_ACTIONS, 'true');
+const application = resolve(process.argv[2]);
+const engine = join(application, 'resources/engine');
+const executable = join(application, 'nod.exe');
+const temporary = await mkdtemp(join(tmpdir(), 'nod-engine-smoke-'));
+const environment = {
+  ...process.env,
+  ELECTRON_RUN_AS_NODE: '1',
+  ESBUILD_WORKER_THREADS: '0',
+  NODE_ENV: 'production',
+  NOD_ANALYTICS_ENABLED: 'false',
+  NOD_DATA_ROOT: temporary,
+  NOD_VAULT_KEY: randomBytes(32).toString('base64'),
+};
+delete environment.ESBUILD_BINARY_PATH;
+try {
+  // The exact same entry used by utilityProcess.fork() in startEngine, with only
+  // server/index.ts replaced by a synthetic TS module. No real DB, WSL or keys.
+  const fixture = join(temporary, 'engine-fixture.ts');
+  await writeFile(
+    fixture,
+    'const answer: number = 6 * 7; console.log("NOD_ENGINE_TS_OK=" + answer);',
+  );
+  const hook = join(temporary, 'engine-hook.mjs');
+  await writeFile(
+    hook,
+    `export async function resolve(specifier, context, next) {\nif (context.parentURL === ${JSON.stringify(pathToFileURL(join(engine, 'desktop/main/engine.mjs')).href)} && specifier === '../../src/server/index.ts') return {url:${JSON.stringify(pathToFileURL(fixture).href)},shortCircuit:true};\nreturn next(specifier,context);\n}`,
+  );
+  const launch = `import { register } from 'node:module'; register(${JSON.stringify(pathToFileURL(hook).href)}, import.meta.url); await import(${JSON.stringify(pathToFileURL(join(engine, 'desktop/main/engine.mjs')).href)});`;
+  const run = (script) => {
+    const result = spawnSync(executable, ['--input-type=module', '-e', script], {
+      cwd: engine,
+      env: environment,
+      encoding: 'utf8',
+      timeout: 180000,
+    });
+    process.stdout.write(result.stdout || '');
+    process.stderr.write(result.stderr || '');
+    assert.equal(result.error, undefined);
+    assert.equal(result.status, 0);
+    return result.stdout;
+  };
+  assert.match(run(launch), /NOD_ENGINE_TS_OK=42/);
+  // Real production dependency graph, not just a synthetic esbuild invocation.
+  const imports = `import assert from 'node:assert/strict';
+import {register} from 'tsx/esm/api';
+const {transformSync} = await import('esbuild');
+assert.match(transformSync('const x: number = 42', {loader:'ts'}).code, /42/);
+register();
+await import('./src/server/composition.ts');
+const {pool} = await import('./src/server/db.ts');
+await pool.end();
+const sharp=(await import('sharp')).default;
+assert.equal((await sharp({create:{width:2,height:2,channels:4,background:'#f00'}}).png().toBuffer()).length > 0,true);
+const {createCanvas}=await import('@napi-rs/canvas'); assert.equal(createCanvas(2,2).width,2);
+console.log('NOD_WINDOWS_ENGINE_IMPORTS_OK');`;
+  assert.match(run(imports), /NOD_WINDOWS_ENGINE_IMPORTS_OK/);
+  console.log('Windows packaged engine smoke passed. Not a Windows10/WSL end-to-end test.');
+} finally {
+  await rm(temporary, { recursive: true, force: true });
+}
diff --git a/desktop/scripts/check-windows-esbuild.mjs b/desktop/scripts/check-windows-esbuild.mjs
new file mode 100644
index 0000000..94cd9e4
--- /dev/null
+++ b/desktop/scripts/check-windows-esbuild.mjs
@@ -0,0 +1,57 @@
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { readFile } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+// Exercise the actual packaged esbuild loader's Windows branch without spawning
+// a foreign executable. Native execution is separately required on Windows CI.
+export async function checkWindowsEsbuild(engine) {
+  const require = createRequire(resolve(engine, 'package.json'));
+  const main = require.resolve('esbuild');
+  const metadata = JSON.parse(await readFile(require.resolve('esbuild/package.json'), 'utf8'));
+  const binary = require.resolve('@esbuild/win32-x64/esbuild.exe');
+  const native = JSON.parse(
+    await readFile(require.resolve('@esbuild/win32-x64/package.json'), 'utf8'),
+  );
+  assert.equal(native.version, metadata.version);
+  assert.deepEqual(native.os, ['win32']);
+  assert.deepEqual(native.cpu, ['x64']);
+  const bytes = await readFile(binary);
+  assert.equal(bytes.subarray(0, 2).toString(), 'MZ');
+  const pe = bytes.readUInt32LE(0x3c);
+  assert.equal(bytes.subarray(pe, pe + 4).toString(), 'PE\0\0');
+  assert.equal(bytes.readUInt16LE(pe + 4), 0x8664);
+  let code = await readFile(main, 'utf8');
+  code += '\nmodule.exports.__probeWindowsBinary = generateBinPath;';
+  const localRequire = createRequire(main);
+  const exports = {};
+  const sandbox = {
+    module: { exports },
+    exports,
+    __filename: main,
+    __dirname: dirname(main),
+    process: { ...process, platform: 'win32', arch: 'x64', env: { ESBUILD_WORKER_THREADS: '0' } },
+    require: Object.assign(
+      (name) =>
+        name === 'os' || name === 'node:os'
+          ? { ...localRequire(name), arch: () => 'x64', endianness: () => 'LE' }
+          : localRequire(name),
+      { resolve: localRequire.resolve },
+    ),
+    Buffer,
+    Uint8Array,
+    console,
+    setTimeout,
+    clearTimeout,
+  };
+  vm.runInNewContext(code, sandbox, { filename: main });
+  const result = sandbox.module.exports.__probeWindowsBinary();
+  assert.equal(result.binPath, binary);
+  assert.equal(result.isWASM, false);
+  return { version: native.version, binary, bytes: bytes.length };
+}
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  console.log(JSON.stringify(await checkWindowsEsbuild(resolve(process.argv[2]))));
+}
diff --git a/desktop/scripts/windows-compatibility.mjs b/desktop/scripts/windows-compatibility.mjs
new file mode 100644
index 0000000..edc3248
--- /dev/null
+++ b/desktop/scripts/windows-compatibility.mjs
@@ -0,0 +1,13 @@
+// Experimental Windows 10 build option, added November 23, 2026.
+// This changes installer admission only. It does not certify runtime compatibility.
+export function windowsCompatibilityBuild(env = process.env) {
+  const value = env.NOD_EXPERIMENTAL_WINDOWS10;
+  if (value !== undefined && value !== '' && value !== 'true' && value !== 'false') {
+    throw new Error('NOD_EXPERIMENTAL_WINDOWS10 must be true or false.');
+  }
+  if (value !== 'true') return [];
+  if (env.NOD_RELEASE_BUILD === 'true') {
+    throw new Error('Experimental Windows 10 builds cannot be official release builds.');
+  }
+  return ['/DNOD_EXPERIMENTAL_WINDOWS10'];
+}
